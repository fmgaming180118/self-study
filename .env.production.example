# ==============================================================================
# Self Study OS - Production Environment Configuration
# ==============================================================================
# Instruksi: Salin file ini menjadi .env.production di server Anda:
#   cp .env.production.example .env.production
# ==============================================================================

# 1. Database (PostgreSQL 15 + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_very_strong_password_here
POSTGRES_DB=self_study_os

# 2. Keamanan & Aplikasi
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Generate SECRET_KEY acak 64 karakter dengan menjalankan di terminal:
#   openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_64_char_hex_key

# 3. Domain & CORS Origins (Pisahkan dengan koma jika lebih dari satu)
# Contoh jika menggunakan domain sendiri: https://learn.selfstudy.dev
CORS_ORIGINS=http://localhost,https://localhost,http://YOUR_SERVER_IP,https://YOUR_DOMAIN.com
FRONTEND_URL=https://YOUR_DOMAIN.com

# 4. AI / LLM Integrations (Opsional - fitur tutor AI & rekomendasi riset)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENALEX_API_KEY=
CONSENSUS_API_KEY=
