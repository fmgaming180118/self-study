# ==============================================================================
# Self Study OS - Comprehensive .gitignore
# Production-ready security & clean source control configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Security, Credentials & Environment Variables
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.production.example
!.env.*.example
backend/.env
frontend/.env
*.pem
*.key
*.crt
*.pfx
*.p12
*.cer
secrets/

# ------------------------------------------------------------------------------
# 2. Database & Backups
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.sql
*.sql.gz
backups/
postgres_data/
postgres_data_prod/

# ------------------------------------------------------------------------------
# 3. Python & Backend
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing, QA & Linting
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.pyre/
.typeguard/
.dmypy.json
dmypy.json

# ------------------------------------------------------------------------------
# 4. Node.js & Frontend (Next.js)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
.turbo/
frontend/.turbo/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store
.vercel
frontend/.vercel
.netlify
frontend/.netlify

# ------------------------------------------------------------------------------
# 5. Docker, SSL & Gateway Runtime
# ------------------------------------------------------------------------------
docker-compose.override.yml
certbot_conf/
certbot_www/

# ------------------------------------------------------------------------------
# 6. Operating System & IDE Caches
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~
*.tmp
*.temp
tmp/
temp/

# ------------------------------------------------------------------------------
# 7. Logs
# ------------------------------------------------------------------------------
*.log
logs/
pip-log.txt
pip-delete-this-directory.txt